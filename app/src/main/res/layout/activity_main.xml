<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="#FAF7FA"
    tools:context=".MainActivity">

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/animationView"
        android:layout_width="352dp"
        android:layout_height="247dp"
        android:layout_marginTop="115dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/banco" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="259dp"
        android:layout_height="22dp"
        android:layout_marginTop="6dp"
        android:text="Cuida tus contraseñas, no las compartas con nadie."
        android:textAlignment="center"
        android:textColor="#010D3C"
        android:textColorHighlight="#3F51B5"
        android:textSize="10sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/animationView" />

    <RadioGroup
        android:id="@+id/radioGroup"
        android:layout_width="350dp"
        android:layout_height="125dp"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.491"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2">

        <androidx.cardview.widget.CardView
            android:layout_width="110dp"
            android:layout_height="100dp"
            app:cardCornerRadius="8dp"
            app:cardUseCompatPadding="true">

            <Button
                android:id="@+id/button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:backgroundTint="#FCF9FC"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingLeft="5dp"
                android:paddingTop="5dp"
                android:paddingRight="5dp"
                android:text="Usuario y contraseña"
                android:textColor="#192963"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="1dp"
                app:icon="@drawable/persona"
                app:iconGravity="textTop"
                app:iconPadding="1dp"
                app:iconSize="30dp"
                app:iconTint="#192963" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="110dp"
            android:layout_height="100dp"
            app:cardCornerRadius="8dp"
            app:cardUseCompatPadding="true">

            <Button
                android:id="@+id/button2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:backgroundTint="#FDFDFD"
                android:text="Huella / Face ID"
                android:textColor="#192963"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="1dp"
                app:icon="@drawable/huella"
                app:iconGravity="textTop"
                app:iconPadding="4dp"
                app:iconSize="30dp"
                app:iconTint="#192963" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="110dp"
            android:layout_height="100dp"
            app:cardCornerRadius="8dp"
            app:cardUseCompatPadding="true">

            <Button
                android:id="@+id/button3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:backgroundTint="#FDFDFD"
                android:text="Pin de 6 dígitos"
                android:textColor="#192963"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="1dp"
                app:icon="@drawable/mas"
                app:iconGravity="textTop"
                app:iconPadding="1dp"
                app:iconSize="30dp"
                app:iconTint="#192963" />
        </androidx.cardview.widget.CardView>

    </RadioGroup>

    <!-- TextView "Ingresar con otro usuario" -->
    <TextView
        android:id="@+id/textView_loginWithOtherUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="112dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center"
        android:padding="10dp"
        android:text="¿Ingresar con otro usuario?"
        android:textColor="#1976D2"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/radioGroup" />

</androidx.constraintlayout.widget.ConstraintLayout>